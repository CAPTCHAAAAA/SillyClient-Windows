{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "types": ["node"],
    "typeRoots": [
      "../../Local/cache/windows/node_modules/@types",
      "node_modules/@types"
    ],
    "baseUrl": ".",
    "paths": {
      "electron": ["../../Local/cache/windows/node_modules/electron"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "web"]
}
